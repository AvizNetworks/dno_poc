# hbn_quickstart.sh settings — copy to <package>/hbn_quickstart.env (picked up
# automatically) or pass with --config FILE. Every line is optional.

# Host SR-IOV VFs per BF3 PF — these are the interfaces ONES assigns IPs to (0 = none)
VFS_PER_PF=4

# Host PF inside HBN?  yes = PF + VFs in HBN (needed e.g. to PXE-boot the host through
# the BF3 uplink).  no = only the VFs (single-port cards only).
HOST_PF_IN_HBN=yes

ENABLE_BGP=yes

# NVUE REST API password (user 'nvidia'). Empty = generated and saved.
REST_PASSWORD=""

# BF3 'ubuntu' password. Empty = generated when the BF3 is flashed.
# Set it to ADOPT a BF3 that already runs bf-bundle 3.3.0 (no re-flash; needs sshpass).
BF3_PASSWORD=""

# BF3 management port (oob_net0). Usually no DHCP there: give a free address in the
# BF3 BMC's subnet. Empty = leave as is (the script itself only needs the rshim link).
OOB_ADDRESS=""          # e.g. 192.0.2.10/24
OOB_GATEWAY=""          # e.g. 192.0.2.1
OOB_DNS="8.8.8.8"

# Files (empty = look next to the package; the BFB is downloaded if not found)
BFB_FILE=""             # bf-bundle-3.3.0-202_26.01_ubuntu-24.04_64k_prod.bfb
HBN_IMAGE_TAR=""        # doca_hbn_3.3.0-doca3.3.0.tar (or .tar.gz); empty + no file = pull on the BF3

# OPTIONAL. A BF3 in NIC mode (SuperNIC cards ship that way) is switched to DPU mode from
# this host with mstconfig — no BMC needed. If set, the script also sets the BF3 UEFI
# NicMode attribute to DpuMode over Redfish (keeps both in agreement), and uses Redfish as
# the fallback if the card refuses the host change. A new BF3 BMC's factory password
# (root/0penBmc) is expired — change it once on the BMC before using it here.
BF3_BMC=""
BF3_BMC_USER="root"
BF3_BMC_PASSWORD=""

# Only if this host has more than one BF3: host PCI address of the BF3's PF0
BF3_PCI=""
